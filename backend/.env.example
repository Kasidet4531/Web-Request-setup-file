# Use DB_HOST=127.0.0.1 when PostgreSQL runs on the same machine as the backend.
# Use DB_HOST=10.0.20.6 for the PostgreSQL test server previously used.
# If the backend runs inside Docker while PostgreSQL runs on the Windows host, use DB_HOST=host.docker.internal.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=psf_setup_db
DB_USER=postgres
DB_PASSWORD=<your-postgres-password>

SESSION_SECRET=<generate-a-local-session-secret>
SESSION_COOKIE_SECURE=false
DEV_AUTH_ENABLED=false
FRONTEND_ORIGIN=http://127.0.0.1:5173

LDAP_AUTH_URL=https://thgbnklak1ms174.wbi.nxp.com/ldap/api/auth/GetLogin
LDAP_AUTH_TIMEOUT_MS=10000
INITIAL_ADMIN_USERNAME=

# Email delivery is paused by default. Destination status policies default to off.
# From is fixed in code to noreply-psf@nxp.com.
MAIL_ENABLED=false
MAIL_SOAP_URL=http://thgbnklak1ms170.wbi.nxp.com/MailService/SendMailService.asmx
MAIL_SYSTEM_NAME=PSF Setup File
MAIL_SMTP_SERVER=smtp.th-bnk01.nxp.com
MAIL_SMTP_PORT=25
MAIL_DEFAULT_TO=
# Optional admin test mailbox; defaults to MAIL_DEFAULT_TO when omitted.
# MAIL_ADMIN_TO=
# Required whenever non-production dispatch is enabled; clears original CC/BCC.
MAIL_REDIRECT_TO=
MAIL_POLL_INTERVAL_MS=15000
MAIL_TIMEOUT_MS=10000
# Set this before enabling any status policy, even while dispatch is paused.
# Enqueued bodies keep this URL permanently. Use the deployed URL in production.
APP_BASE_URL=http://127.0.0.1:5173
